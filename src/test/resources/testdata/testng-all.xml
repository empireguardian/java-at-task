<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="All tests"
       parallel="tests"
       thread-count="2">

    <listeners>
        <listener class-name="com.epam.ta.utilities.TestListener"/>
    </listeners>

    <test name="Chrome">

        <parameter name="browser" value="chrome"/>

        <packages>
            <package name="com.epam.ta.test"/>
        </packages>

    </test>

    <test name="Firefox">

        <parameter name="browser" value="firefox"/>

        <packages>
            <package name="com.epam.ta.test"/>
        </packages>

    </test>

</suite>